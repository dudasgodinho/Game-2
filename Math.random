<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Guardiã da Floresta - Versão Final</title>
    <style>
        * { box-sizing: border-box; }
        body {
            background-color: #0f1210;
            color: #f0f5f1;
            font-family: 'Courier New', Courier, monospace;
            text-align: center;
            margin: 0;
            padding: 15px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }
        h1 {
            margin: 0 0 10px 0;
            font-size: 26px;
            color: #8be39a;
            text-shadow: 2px 2px #1b3d22;
        }
        #tela-narrativa {
            width: 900px;
            max-width: 100%;
            background: #19221a;
            padding: 20px;
            border-radius: 8px;
            border: 4px solid #38523c;
            font-size: 16px;
            line-height: 1.5;
            margin-bottom: 15px;
            box-shadow: 0 6px 0 #0d140e;
        }
        #container-jogo {
            position: relative;
            width: 900px;
            height: 600px;
        }
        canvas {
            border: 6px solid #38523c;
            border-radius: 6px;
            display: block;
            box-shadow: 0 12px 36px rgba(0,0,0,0.9);
        }
        .controles-info {
            margin-top: 15px;
            color: #6b7d6f;
            font-size: 14px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        #btn-reiniciar {
            position: absolute;
            top: 85%;
            left: 50%;
            transform: translate(-50%, -50%);
            padding: 16px 32px;
            font-size: 22px;
            font-family: inherit;
            font-weight: bold;
            background: #27ae60;
            color: white;
            border: 3px solid #fff;
            cursor: pointer;
            border-radius: 8px;
            display: none;
            box-shadow: 0 6px 0 #1b6337;
            text-transform: uppercase;
        }
        #btn-reiniciar:hover { background: #2ecc71; }
        #btn-reiniciar:active {
            transform: translate(-50%, -46%);
            box-shadow: none;
        }
    </style>
</head>
<body>

    <h1>🌳 GUARDIÃ DA FLORESTA 🌳</h1>

    <div id="tela-narrativa">
        <span id="texto-fase" style="color: #f1c40f; font-weight: bold;"></span><br>
        <span id="texto-historia">Carregando todos os pixels e cenários do jogo...</span>
    </div>

    <div id="container-jogo">
        <canvas id="jogo" width="900" height="600"></canvas>
        <button id="btn-reiniciar" onclick="location.reload()">Jogar Novamente</button>
    </div>

    <p class="controles-info">Controles: Setas [ ← ] [ → ] para andar • Seta [ ↑ ] para Pular</p>

<script>
const canvas = document.getElementById('jogo');
const ctx = canvas.getContext('2d');
const txtFase = document.getElementById('texto-fase');
const txtHistoria = document.getElementById('texto-historia');
const btnReiniciar = document.getElementById('btn-reiniciar');

// --- CARREGAMENTO DO BANCO DE IMAGENS ---
const imgViva = new Image(); imgViva.src = 'floresta_viva.png';
const imgDestruida = new Image(); imgDestruida.src = 'floresta_destruida.png';
const imgFogo = new Image(); imgFogo.src = 'floresta_fogo.png';         
const imgAnimais = new Image(); imgAnimais.src = 'floresta_animais.png'; 
const imgYouWin = new Image(); imgYouWin.src = 'you_win.png';
const imgGameOver = new Image(); imgGameOver.src = 'game_over.png';
const imgItens = new Image(); imgItens.src = 'itens.png';

let estadoJogo = 'fase1'; 

const jogador = {
    x: 80,
    y: 400,
    largura: 65,  
    altura: 110, 
    velocidade: 6,
    velY: 0,
    pulo: 15,
    noChao: false,
    olhandoParaEsquerda: false
};

const gravidade = 0.7;
const chaoY = 535; 

let estrelas = [];

function atualizarConfiguracaoFase() {
    jogador.x = 80; 
    jogador.y = chaoY - jogador.altura;
    jogador.velY = 0;

    if (estadoJogo === 'fase1') {
        txtFase.innerText = "FASE 1: O Alerta Ecológico";
        txtHistoria.innerText = "A floresta corre perigo! Caminhe pelo cenário para decidir as ações de preservação. Pegue a primeira estrela para iniciar um mutirão de reflorestamento na nascente ou avance até a próxima estrela para investigar uma fumaça de incêndio que surge no horizonte.";
        
        estrelas = [
            { x: 340, y: 320, tamanho: 45, tipo: 'verde', descricao: 'Reflorestar Nascentes' },
            { x: 720, y: 320, tamanho: 45, tipo: 'laranja', descricao: 'Investigar Fumaça' }
        ];
    } 
    else if (estadoJogo === 'fase2A') {
        txtFase.innerText = "FASE 2A: O Vale Preservado";
        txtHistoria.innerText = "Excelente! O plantio de árvores salvou os rios e atraiu dezenas de espécies de animais de volta! Porém, caçadores ilegais deixaram armadilhas na mata. Pegue a primeira estrela para desarmar as armadilhas ou a segunda para ignorar e seguir viagem.";
        
        estrelas = [
            { x: 340, y: 320, tamanho: 45, tipo: 'azul', descricao: 'Proteger Animais' },
            { x: 720, y: 320, tamanho: 45, tipo: 'amarela', descricao: 'Ignorar Ameaça' }
        ];
    } 
    else if (estadoJogo === 'fase2B') {
        txtFase.innerText = "FASE 2B: O Incêndio Fora de Controle";
        txtHistoria.innerText = "Socorro! As chamas estão consumindo as árvores rapidamente! Você precisa agir antes que seja tarde demais. Pegue a primeira estrela para arriscar tudo e abafar o fogo com terra, ou pegue a segunda estrela para desistir por medo e fugir.";
        
        estrelas = [
            { x: 340, y: 320, tamanho: 45, tipo: 'marrom', descricao: 'Combater Incêndio' },
            { x: 720, y: 320, tamanho: 45, tipo: 'roxa', descricao: 'Desistir e Fugir' }
        ];
    }
    else {
        estrelas = [];
        btnReiniciar.style.display = 'block';
        
        if (estadoJogo === 'ganhou') {
            txtFase.innerText = "🌳 YOU WIN! 🌳";
            txtHistoria.innerText = "Parabéns, Protetora! Suas ações conscientes salvaram a biodiversidade. A fauna e a flora voltaram a prosperar juntas em perfeito equilíbrio!";
        }
        else if (estadoJogo === 'gameOverLixo' || estadoJogo === 'gameOverFogo') {
            txtFase.innerText = "💥 GAME OVER 💥";
            txtHistoria.innerText = "O desmatamento e a poluição venceram desta vez. A reserva ecológica foi consumida e destruída devido às escolhas tardias.";
        }
    }
}

const teclasPressionadas = {};
window.addEventListener('keydown', e => {
    if(['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.code)) e.preventDefault();
    teclasPressionadas[e.code] = true;
});
window.addEventListener('keyup', e => teclasPressionadas[e.code] = false);

function verificarColisao(obj1, obj2) {
    return obj1.x < obj2.x + obj2.tamanho &&
           obj1.x + obj1.largura > obj2.x &&
           obj1.y < obj2.y + obj2.tamanho &&
           obj1.y + obj1.altura > obj2.y;
}

function atualizarFisica() {
    if (estadoJogo === 'ganhou' || estadoJogo.startsWith('gameOver')) return;

    if (teclasPressionadas['ArrowRight']) {
        jogador.x += jogador.velocidade;
        jogador.olhandoParaEsquerda = false;
    }
    if (teclasPressionadas['ArrowLeft']) {
        jogador.x -= jogador.velocidade;
        jogador.olhandoParaEsquerda = true;
    }

    if (teclasPressionadas['ArrowUp'] && jogador.noChao) {
        jogador.velY = -jogador.pulo;
        jogador.noChao = false;
    }

    jogador.velY += gravidade;
    jogador.y += jogador.velY;

    if (jogador.x < 0) jogador.x = 0;
    if (jogador.x + jogador.largura > canvas.width) jogador.x = canvas.width - jogador.largura;

    if (jogador.y + jogador.altura >= chaoY) {
        jogador.y = chaoY - jogador.altura;
        jogador.velY = 0;
        jogador.noChao = true;
    }

    for (let i = 0; i < estrelas.length; i++) {
        if (verificarColisao(jogador, estrelas[i])) {
            const acaoTipo = estrelas[i].tipo;
            
            if (acaoTipo === 'verde') estadoJogo = 'fase2A';
            else if (acaoTipo === 'laranja') estadoJogo = 'fase2B';
            else if (acaoTipo === 'azul') estadoJogo = 'ganhou';
            else if (acaoTipo === 'amarela') estadoJogo = 'gameOverLixo';
            else if (acaoTipo === 'marrom') estadoJogo = 'fase2A'; 
            else if (acaoTipo === 'roxa') estadoJogo = 'gameOverFogo';

            atualizarConfiguracaoFase();
            break;
        }
    }
}

function renderizarGraficos() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    // 1. Renderiza o cenário de fundo correto para cada estado
    if (estadoJogo === 'ganhou') {
        ctx.drawImage(imgYouWin, 0, 0, canvas.width, canvas.height);
    } 
    else if (estadoJogo.startsWith('gameOver')) {
        ctx.drawImage(imgGameOver, 0, 0, canvas.width, canvas.height);
    } 
    else if (estadoJogo === 'fase1') {
        ctx.drawImage(imgViva, 0, 0, canvas.width, canvas.height);
    } 
    else if (estadoJogo === 'fase2A') {
        ctx.drawImage(imgAnimais, 0, 0, canvas.width, canvas.height); 
    } 
    else if (estadoJogo === 'fase2B') {
        ctx.drawImage(imgFogo, 0, 0, canvas.width, canvas.height); 
    }

    // 2. Desenho da Personagem principal (apenas durante o gameplay ativo)
    if (!estadoJogo.startsWith('gameOver') && estadoJogo !== 'ganhou') {
        ctx.save();
        
        let imagemOrigemSprite = imgViva;
        if (estadoJogo === 'fase2A') imagemOrigemSprite = imgAnimais;
        if (estadoJogo === 'fase2B') imagemOrigemSprite = imgFogo;

        if (jogador.olhandoParaEsquerda) {
            ctx.translate(jogador.x + jogador.largura, jogador.y);
            ctx.scale(-1, 1);